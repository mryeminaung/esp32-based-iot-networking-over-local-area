DATABASE_URL=""
PORT=8000

# ESP32 base URL (STA mode IP from Serial Monitor, or mDNS http://esp32-server.local)
# Used by device routes + collector to proxy/sensors from the ESP32
ESP32_API_URL="http://192.168.1.100"

# JWT Secrets (change these in production!)
JWT_SECRET="your-access-token-secret"
JWT_REFRESH_SECRET="your-refresh-token-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Seed Admin
ADMIN_EMAIL=""
ADMIN_PASSWORD=""