// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  name          String?
  image         String?
  password      String
  role          String         @default("farm_worker")
  refreshTokens RefreshToken[]
  activityLogs  ActivityLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now())

  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  device    String
  action    String
  value     Int?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

model SensorReading {
  id           Int      @id @default(autoincrement())
  deviceId     Int      @default(1) @map("device_id")
  temperature  Float?
  humidity     Float?
  soilMoisture Float?   @map("soil_moisture")
  light        Float?
  airQuality   Float?   @map("air_quality")
  waterLevel   Float?   @map("water_level")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([deviceId])
  @@index([createdAt])
  @@map("sensor_readings")
}

model DeviceSettings {
  id                     Int      @id @default(autoincrement())
  soilDryThreshold       Float    @default(30) @map("soil_dry_threshold")
  soilOptimalThreshold   Float    @default(50) @map("soil_optimal_threshold")
  waterLowThreshold      Float    @default(25) @map("water_low_threshold")
  waterCriticalThreshold Float    @default(10) @map("water_critical_threshold")
  waterWarningEnabled    Boolean  @default(true) @map("water_warning_enabled")
  buzzerEnabled          Boolean  @default(true) @map("buzzer_enabled")
  buzzerLowWater         Boolean  @default(true) @map("buzzer_low_water")
  buzzerDrySoil          Boolean  @default(true) @map("buzzer_dry_soil")
  buzzerSensorError      Boolean  @default(false) @map("buzzer_sensor_error")
  lightLowThreshold      Int      @default(50) @map("light_low_threshold")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("device_settings")
}
