// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  name          String?
  image         String?
  password      String
  role          String         @default("farm_worker")
  refreshTokens RefreshToken[]
  activityLogs  ActivityLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now())
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  device    String
  action    String
  value     Int?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

model SensorReading {
  id           Int      @id @default(autoincrement())
  deviceId     Int      @default(1) @map("device_id")
  temperature  Float?
  humidity     Float?
  soilMoisture Float?   @map("soil_moisture")
  light        Float?
  airQuality   Float?   @map("air_quality")
  waterLevel   Float?   @map("water_level")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([deviceId])
  @@index([createdAt])
  @@map("sensor_readings")
}

model AutomationRule {
  id            Int       @id @default(autoincrement())
  name          String
  enabled       Boolean   @default(true)
  sensor        String    // soilMoisture, temperature, humidity, light, airQuality, waterLevel
  condition     String    // below, above, equals
  threshold     Float
  action        String    // pump_on, pump_off, led_on, led_off
  duration      Int?      // auto-off after N seconds (null = stay on until manual off)
  cooldown      Int       @default(300) // minimum seconds between triggers
  lastTriggered DateTime?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("automation_rules")
}
